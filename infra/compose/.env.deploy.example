# 使用 `bash scripts/deploy.sh init` 生成真实配置，禁止提交密钥。
MYSQL_ROOT_PASSWORD=please-change-root
MYSQL_USER=qt_app
MYSQL_PASSWORD=please-change-app

AUTH_JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
AUTH_TOTP_ENCRYPTION_KEY=please-change-to-a-fernet-key

ENVIRONMENT=production
SINGLE_OWNER_MODE=true
QT_BIND_HOST=127.0.0.1
MYSQL_PORT=3306
IDENTITY_PORT=8001
TRADING_PORT=8004
WEB_BIND_HOST=0.0.0.0
WEB_PORT=8080
PIP_INDEX_URL=https://pypi.org/simple

BINANCE_CREDENTIAL_MASTER_KEY_FILE=/opt/quant-trading/secrets/credential-master-key
BINANCE_CREDENTIAL_MASTER_KEY_UID=100
BINANCE_ENVIRONMENT=demo
DEMO_TRADING_ENABLED=false
PUBLIC_BASE_URL=
