# 云端部署环境变量模板（不要直接用于部署）
# 推荐执行 `bash scripts/deploy.sh init` 自动生成真实密钥。
# .env.deploy 已被 .gitignore 忽略，不会进入仓库。

# ---- 依赖组件（compose 基础文件需要）----
MYSQL_ROOT_PASSWORD=please-change-root
MYSQL_DATABASE=qt_platform
MYSQL_USER=qt_app
MYSQL_PASSWORD=please-change-app
MINIO_ROOT_USER=qt_minio
MINIO_ROOT_PASSWORD=please-change-minio

# ---- 依赖和后端端口（仅绑定服务器回环地址）----
QT_BIND_HOST=127.0.0.1
QT_MYSQL_PORT=3306
QT_REDIS_PORT=6379
QT_KAFKA_PORT=9092
QT_SCHEMA_REGISTRY_PORT=8081
QT_MINIO_PORT=9000
QT_MINIO_CONSOLE_PORT=9001
QT_MAILPIT_SMTP_PORT=1025
QT_MAILPIT_PORT=8025

# ---- 业务服务密钥（必须修改）----
AUTH_JWT_SECRET=please-change-to-a-random-string-at-least-32-chars
AUTH_TOTP_ENCRYPTION_KEY=please-change-to-a-fernet-key
SECRET_ENCRYPTION_KEY=please-change-to-a-fernet-key

# ---- 币安只读 UAT（readonly-up 前必须配置）----
KMS_SERVICE_TOKEN=please-change-to-a-random-string-at-least-32-chars
RISK_SERVICE_TOKEN=please-change-to-a-different-random-string-at-least-32-chars
KMS_KEY_ID=
KMS_REGION=cn-beijing
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_SESSION_TOKEN=
FIXED_EGRESS_IP_CONFIGURED=false
PUBLIC_BASE_URL=

# ---- Web 公网端口与后端本机诊断端口 ----
ENVIRONMENT=production
WEB_PORT=80
IDENTITY_PORT=8001
AUDIT_PORT=8002
MODEL_CONFIG_PORT=8003
TRADING_PORT=8004
RISK_PORT=8005
KMS_ADAPTER_PORT=8006
