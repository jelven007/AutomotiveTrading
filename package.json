{
  "name": "quant-trading-saas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "format:check": "prettier --check \"**/*.{css,html,json,js,jsx,md,ts,tsx,yaml,yml}\"",
    "lint": "pnpm format:check && markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#.venv\" && pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.18.1",
    "prettier": "3.6.2"
  }
}
