SERVICE_NAME=trading
ENVIRONMENT=local
DATABASE_URL=sqlite+pysqlite:///./trading.db
LOG_LEVEL=INFO
AUTH_ISSUER=https://identity.quant-trading.local
AUTH_AUDIENCE=quant-api
AUTH_JWT_SECRET=
MFA_MAX_AGE_SECONDS=300
BINANCE_CREDENTIAL_MASTER_KEY_FILE=/opt/quant-trading/secrets/credential-master-key
LIVE_TRADING_ENABLED=false
FIXED_EGRESS_IP_CONFIGURED=false
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_TESTNET_ENABLED=false
