{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quant-trading.local/model-decision-v1.json",
  "title": "Model Decision V1",
  "description": "Analysis-only model output. Execution and account fields are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "confidence",
    "target_position_pct",
    "order_type",
    "limit_price",
    "valid_until",
    "reasons",
    "risk_flags"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["buy", "sell", "hold"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "target_position_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "order_type": {
      "type": "string",
      "enum": ["market", "limit"]
    },
    "limit_price": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order_type": {
            "const": "limit"
          }
        },
        "required": ["order_type"]
      },
      "then": {
        "properties": {
          "limit_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          }
        }
      }
    }
  ]
}
