{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quant-trading.local/schemas/market-quote-v1.json",
  "title": "MarketQuoteV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange",
    "symbol",
    "source_time",
    "collected_at",
    "last_price",
    "previous_close",
    "open_price",
    "high_price",
    "low_price",
    "volume",
    "amount",
    "bids",
    "asks",
    "provider",
    "source_id",
    "payload_hash",
    "quality_status",
    "schema_version"
  ],
  "properties": {
    "exchange": {
      "type": "string",
      "enum": ["SSE", "SZSE", "BSE"]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "source_time": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_price": {
      "$ref": "#/$defs/decimal"
    },
    "previous_close": {
      "$ref": "#/$defs/decimal"
    },
    "open_price": {
      "$ref": "#/$defs/decimal"
    },
    "high_price": {
      "$ref": "#/$defs/decimal"
    },
    "low_price": {
      "$ref": "#/$defs/decimal"
    },
    "volume": {
      "$ref": "#/$defs/decimal"
    },
    "amount": {
      "$ref": "#/$defs/decimal"
    },
    "bids": {
      "$ref": "#/$defs/levels"
    },
    "asks": {
      "$ref": "#/$defs/levels"
    },
    "provider": {
      "type": "string",
      "enum": ["mootdx", "tushare"]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "healthy",
        "stale",
        "partial",
        "conflict",
        "invalid",
        "unavailable"
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quantity"],
      "properties": {
        "price": {
          "$ref": "#/$defs/decimal"
        },
        "quantity": {
          "$ref": "#/$defs/decimal"
        }
      }
    },
    "levels": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/level"
      }
    }
  }
}
